AUTH_URL="http://localhost:3000"
ENABLE_DEMO_AUTH="false"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="training-resources"
