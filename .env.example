# Gunakan project yang sama untuk PostgreSQL, Supabase Auth, dan Storage.
# tq-lms saat ini: hdjumgxtubpruwlluahs. Isi password peran tq_lms_app.
DATABASE_URL="postgresql://tq_lms_app.hdjumgxtubpruwlluahs:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&schema=lms&sslmode=require"
DIRECT_URL="postgresql://tq_lms_app.hdjumgxtubpruwlluahs:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?connection_limit=1&schema=lms&sslmode=require"
# Hanya dibutuhkan saat membuat migrasi baru (prisma migrate dev).
# Kosongkan di produksi: prisma migrate deploy tidak memakai shadow database.
SHADOW_DATABASE_URL=""
AUTH_SECRET="generate-a-random-secret-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
ENABLE_DEMO_AUTH="false"
SUPABASE_URL="https://hdjumgxtubpruwlluahs.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="training-resources"
# Bucket privat di atas dibuat sekali dengan: npm run storage:setup
# Tanpa ketiga nilai Supabase itu, unggahan berkas tidak muncul dan materi
# maupun tugas tetap dibagikan sebagai tautan.
RESEND_API_KEY=""
MAIL_FROM="TQ Learning <noreply@contoh.co.id>"
# Tanpa kedua nilai di atas tidak ada surel yang dikirim: tautan undangan
# ditampilkan kepada administrator untuk diteruskan, dan pemberitahuan hanya
# muncul pada bel di kepala halaman.
